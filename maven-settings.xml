<?xml version="1.0" encoding="UTF-8"?>
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 
  http://maven.apache.org/xsd/settings-1.0.0.xsd">

  <!-- ========================================================
       NEXUS REPOSITORY MANAGER CONFIGURATION
       
       This file is a TEMPLATE used by Jenkins CI/CD pipeline.
       Placeholders (NEXUS_USER_PLACEHOLDER, NEXUS_PASS_PLACEHOLDER)
       are replaced at runtime with actual credentials.
       
       DO NOT commit credentials to this file.
       ======================================================== -->

  <servers>
    <!-- Authentication for Nexus mirror (maven-public) -->
    <server>
      <id>nexus</id>
      <username>NEXUS_USER_PLACEHOLDER</username>
      <password>NEXUS_PASS_PLACEHOLDER</password>
    </server>

    <!-- Authentication for deploying to releases repository -->
    <server>
      <id>nexus-releases</id>
      <username>NEXUS_USER_PLACEHOLDER</username>
      <password>NEXUS_PASS_PLACEHOLDER</password>
    </server>

    <!-- Authentication for deploying to snapshots repository -->
    <server>
      <id>nexus-snapshots</id>
      <username>NEXUS_USER_PLACEHOLDER</username>
      <password>NEXUS_PASS_PLACEHOLDER</password>
    </server>
  </servers>

  <!-- Repository Mirrors: Route ALL dependency requests through Nexus -->
  <mirrors>
    <!-- Primary mirror: captures all (*) dependency requests -->
    <mirror>
      <id>nexus</id>
      <mirrorOf>*,!nexus-releases,!nexus-snapshots</mirrorOf>
      <name>Nexus Repository Group</name>
      <url>http://nexus:8081/repository/maven-public/</url>
    </mirror>
  </mirrors>

  <!-- Repository Profiles: Define access to releases and snapshots -->
  <profiles>
    <profile>
      <id>nexus</id>
      
      <!-- Dependency Repositories: Where Maven fetches libraries -->
      <repositories>
        <repository>
          <id>nexus-releases</id>
          <name>Nexus Releases</name>
          <url>http://nexus:8081/repository/maven-releases/</url>
          <releases>
            <enabled>true</enabled>
            <updatePolicy>never</updatePolicy>
          </releases>
          <snapshots>
            <enabled>false</enabled>
          </snapshots>
        </repository>

        <repository>
          <id>nexus-snapshots</id>
          <name>Nexus Snapshots</name>
          <url>http://nexus:8081/repository/maven-snapshots/</url>
          <releases>
            <enabled>false</enabled>
          </releases>
          <snapshots>
            <enabled>true</enabled>
            <updatePolicy>always</updatePolicy>
          </snapshots>
        </repository>
      </repositories>

      <!-- Plugin Repositories: Where Maven fetches build plugins -->
      <pluginRepositories>
        <pluginRepository>
          <id>nexus-releases</id>
          <name>Nexus Plugin Releases</name>
          <url>http://nexus:8081/repository/maven-releases/</url>
          <releases>
            <enabled>true</enabled>
            <updatePolicy>never</updatePolicy>
          </releases>
          <snapshots>
            <enabled>false</enabled>
          </snapshots>
        </pluginRepository>

        <pluginRepository>
          <id>nexus-snapshots</id>
          <name>Nexus Plugin Snapshots</name>
          <url>http://nexus:8081/repository/maven-snapshots/</url>
          <releases>
            <enabled>false</enabled>
          </releases>
          <snapshots>
            <enabled>true</enabled>
            <updatePolicy>always</updatePolicy>
          </snapshots>
        </pluginRepository>
      </pluginRepositories>
    </profile>
  </profiles>

  <!-- Active Profiles: Ensure Nexus profile is always active -->
  <activeProfiles>
    <activeProfile>nexus</activeProfile>
  </activeProfiles>

</settings>
