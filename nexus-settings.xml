<?xml version="1.0" encoding="UTF-8"?>
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 
  http://maven.apache.org/xsd/settings-1.0.0.xsd">

  <servers>
    <server>
      <id>nexus</id>
      <username>NEXUS_USER_PLACEHOLDER</username>
      <password>NEXUS_PASS_PLACEHOLDER</password>
    </server>
    <server>
      <id>nexus-releases</id>
      <username>NEXUS_USER_PLACEHOLDER</username>
      <password>NEXUS_PASS_PLACEHOLDER</password>
    </server>
    <server>
      <id>nexus-snapshots</id>
      <username>NEXUS_USER_PLACEHOLDER</username>
      <password>NEXUS_PASS_PLACEHOLDER</password>
    </server>
  </servers>

  <mirrors>
    <mirror>
      <id>nexus</id>
      <mirrorOf>*,!nexus-releases,!nexus-snapshots</mirrorOf>
      <name>Nexus Repository Group</name>
      <url>http://nexus:8081/repository/maven-public/</url>
    </mirror>
  </mirrors>

  <profiles>
    <profile>
      <id>nexus</id>
      
      <repositories>
        <repository>
          <id>nexus-releases</id>
          <name>Nexus Releases</name>
          <url>http://nexus:8081/repository/maven-releases/</url>
          <releases>
            <enabled>true</enabled>
            <updatePolicy>never</updatePolicy>
          </releases>
          <snapshots>
            <enabled>false</enabled>
          </snapshots>
        </repository>

        <repository>
          <id>nexus-snapshots</id>
          <name>Nexus Snapshots</name>
          <url>http://nexus:8081/repository/maven-snapshots/</url>
          <releases>
            <enabled>false</enabled>
          </releases>
          <snapshots>
            <enabled>true</enabled>
            <updatePolicy>always</updatePolicy>
          </snapshots>
        </repository>
      </repositories>

      <pluginRepositories>
        <pluginRepository>
          <id>nexus-releases</id>
          <name>Nexus Plugin Releases</name>
          <url>http://nexus:8081/repository/maven-releases/</url>
          <releases>
            <enabled>true</enabled>
            <updatePolicy>never</updatePolicy>
          </releases>
          <snapshots>
            <enabled>false</enabled>
          </snapshots>
        </pluginRepository>

        <pluginRepository>
          <id>nexus-snapshots</id>
          <name>Nexus Plugin Snapshots</name>
          <url>http://nexus:8081/repository/maven-snapshots/</url>
          <releases>
            <enabled>false</enabled>
          </releases>
          <snapshots>
            <enabled>true</enabled>
            <updatePolicy>always</updatePolicy>
          </snapshots>
        </pluginRepository>
      </pluginRepositories>
    </profile>
  </profiles>

  <activeProfiles>
    <activeProfile>nexus</activeProfile>
  </activeProfiles>

</settings>